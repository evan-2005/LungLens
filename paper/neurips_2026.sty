%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  neurips_2026.sty  --  DROP-IN COMPATIBILITY PLACEHOLDER  (v0.2)
%
%  This is NOT the official NeurIPS 2026 style file. It is a self-contained
%  stand-in that reproduces the documented layout closely enough to draft and
%  page-count against without a network round-trip to the venue template:
%
%    * text block 5.5in x 9in, left margin 1.5in, page body starts 1in down
%    * 10pt Times, 11pt leading, 1/2-line (5.5pt) paragraph spacing, no indent
%    * 17pt bold title, initial caps, centred between a 4pt and a 1pt rule
%    * "Abstract" centred, bold, 12pt; abstract body indented 1/2in each side
%    * first-level headings 12pt bold sentence case flush left; L2/L3 10pt bold
%    * \paragraph: bold, inline, flush left, 1em trailing space
%    * line numbers in submission mode; page numbers always
%    * \begin{ack} ... \end{ack} is hidden unless [final]
%
%  BEFORE SUBMISSION: replace this file with the official neurips_2026.sty from
%  https://neurips.cc and recompile. Track options below match the official
%  menu; \workshoptitle is accepted for the workshop tracks.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/05/01 v0.2 NeurIPS 2026 compatibility placeholder]

\newif\if@nips@final       \@nips@finalfalse
\newif\if@nips@preprint    \@nips@preprintfalse
\newif\if@nips@natbib      \@nips@natbibtrue
\newif\if@nips@workshop    \@nips@workshopfalse

\DeclareOption{final}{\@nips@finaltrue}
\DeclareOption{preprint}{\@nips@preprinttrue}
\DeclareOption{nonatbib}{\@nips@natbibfalse}
\DeclareOption{default}{}
\DeclareOption{main}{}
\DeclareOption{position}{}
\DeclareOption{eandd}{}
\DeclareOption{creativeai}{}
\DeclareOption{education}{}
\DeclareOption{sglblindworkshop}{\@nips@workshoptrue}
\DeclareOption{dblblindworkshop}{\@nips@workshoptrue}
\DeclareOption*{\PackageWarning{neurips_2026}{Unknown option `\CurrentOption' ignored by the placeholder style.}}
\ProcessOptions\relax

%%% Geometry: US Letter, 5.5in x 9in text, 1.5in left margin, 1in from top. %%%
\RequirePackage[letterpaper,
  textwidth=5.5in, textheight=9in,
  left=1.5in, top=1in,
  headheight=12pt, headsep=0.25in, footskip=0.4in]{geometry}

\RequirePackage{fancyhdr}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}
\linespread{1.02}   % ~11pt leading on a 10pt body

%%% Fonts: Times for text and math. %%%
\RequirePackage{mathptmx}

%%% Line numbers for review (suppressed for camera-ready). %%%
\if@nips@final\else
  \if@nips@preprint\else
    \RequirePackage{lineno}
    \renewcommand\linenumberfont{\normalfont\tiny\sffamily\color{gray}}
    \AtBeginDocument{\linenumbers}
  \fi
\fi

%%% Headings. %%%
\RequirePackage[compact]{titlesec}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries}{\thesubsubsection}{0.6em}{}
\titleformat{\paragraph}[runin]{\normalfont\normalsize\bfseries}{}{0pt}{}[\hspace{0.4em}]
\titlespacing*{\section}{0pt}{2.0ex plus .8ex minus .2ex}{1.0ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus .8ex minus .2ex}{0.8ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus .6ex minus .2ex}{0.6ex plus .2ex}
\titlespacing*{\paragraph}{0pt}{1.0ex plus .4ex}{0.4em}

%%% Title block: 17pt bold, centred, between a 4pt and a 1pt rule. %%%
\newcommand{\workshoptitle}[1]{\gdef\@workshoptitle{#1}}
\gdef\@workshoptitle{}
\renewcommand{\@maketitle}{%
  \newpage \null \vskip 0.25in
  {\hrule height 4pt}\vskip 0.25in
  \begin{center}{\fontsize{17}{20}\selectfont\bfseries \@title \par}\end{center}
  \vskip 0.25in {\hrule height 1pt}\vskip 0.30in
  \begin{center}%
    {\normalsize \lineskip .5em \begin{tabular}[t]{c}\@author\end{tabular}\par}%
  \end{center}\par
  \if@nips@workshop
    \ifx\@workshoptitle\@empty\else
      \vskip 0.6em \begin{center}\footnotesize Workshop: \@workshoptitle\end{center}
    \fi
  \fi
  \vskip 0.4in
}

\providecommand{\And}{\end{tabular}\hfil\begin{tabular}[t]{c}}
\providecommand{\AND}{\end{tabular}\hfil\begin{tabular}[t]{c}}

%%% Abstract: 1/2in each side, bold centred 12pt "Abstract", 2 line spaces before. %%%
\renewenvironment{abstract}{%
  \vskip 2\baselineskip
  \begin{center}{\fontsize{12}{14}\selectfont\bfseries Abstract}\end{center}
  \vspace{0.5em}
  \begin{list}{}{\setlength{\leftmargin}{0.5in}\setlength{\rightmargin}{0.5in}%
    \setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}\item[]\small\ignorespaces
}{%
  \end{list}\vskip 1.5\baselineskip
}

%%% Acknowledgements: hidden unless [final]. %%%
\RequirePackage{comment}
\if@nips@final
  \newenvironment{ack}{\subsection*{Acknowledgments and disclosure of funding}}{}
\else
  \excludecomment{ack}
\fi

%%% natbib unless [nonatbib]. %%%
\if@nips@natbib
  \RequirePackage[numbers,sort&compress,square,comma]{natbib}
\fi
\renewcommand{\bibsection}{\section*{References}\small}
\setlength{\bibsep}{2pt plus 1pt}

%%% Submission footer note (non-final). %%%
\if@nips@final\else
  \if@nips@preprint
    \fancyfoot[C]{\thepage\\[2pt]\footnotesize Preprint. Work in progress.}
  \else
    \fancyfoot[C]{\thepage\\[2pt]\footnotesize
      Submitted to the 40th Conference on Neural Information Processing Systems (NeurIPS 2026). Do not distribute.}
  \fi
\fi

\RequirePackage{xcolor}
\endinput
